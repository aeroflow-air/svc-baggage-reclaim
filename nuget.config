<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Source only. Do not put a token in this file.
         GitHub Packages requires auth even for public packages.
         Local: a PAT with read:packages in your user-level NuGet config (see README).
         CI: dotnet-ci.yml@v0.7.0 with github-packages: true and packages: read.
         Docker: --secret id=nuget_auth_token (see Dockerfile). -->
    <add key="aeroflow-air" value="https://nuget.pkg.github.com/aeroflow-air/index.json" />
  </packageSources>
</configuration>
